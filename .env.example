# AWS credentials are read by boto3 from the standard chain
# (env vars, ~/.aws/credentials, or an instance role).
AWS_REGION=us-east-1

# Bedrock model used by the semantic grader.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5

# MCP server bind address.
RECALL_HOST=0.0.0.0
RECALL_PORT=8080

# SQLite store location.
RECALL_DB_PATH=./recall.db
