# AWS credentials are read by boto3 from the standard chain
# (env vars, ~/.aws/credentials, or an instance role).
AWS_REGION=us-east-1

# A Bedrock API key is the simplest credential for this project: it is scoped
# to Bedrock by construction, so there is no IAM policy to get wrong and no
# broadly-permissioned key sitting in ~/.aws/credentials. Create one at
# Bedrock console -> Discover -> API keys. Leave blank to fall back to the
# standard boto3 credential chain instead.
AWS_BEARER_TOKEN_BEDROCK=

# Bedrock model used by the semantic grader.
# Sonnet 5 is visible in the catalogue but returns AccessDenied on a Free
# plan account; Sonnet 4.5 and Haiku 4.5 both work. See the friction log.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# MCP server bind address.
RECALL_HOST=0.0.0.0
RECALL_PORT=8080

# SQLite store location.
RECALL_DB_PATH=./recall.db
